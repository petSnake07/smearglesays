rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dailyDrawings/{drawingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /ratings/{ratingId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == ratingId
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.score is number
          && request.resource.data.score >= 1
          && request.resource.data.score <= 10
          && get(/databases/$(database)/documents/dailyDrawings/$(drawingId)).data.ownerUid != request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == ratingId;
      }
    }
  }
}
